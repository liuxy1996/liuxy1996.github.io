{
  "name": "study-room-library",
  "version": "1.1.0",
  "private": true,
  "description": "A private study library: runnable Python, essays, and a podcast, deployed as a static site.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "npm run sync:pyodide && next dev",
    "clean:out": "node scripts/clean-out.mjs",
    "build": "npm run sync:pyodide && npm run clean:out && next build && node scripts/fix-static-rsc.mjs",
    "build:pages": "npm run build && node scripts/export-static-to-root.mjs",
    "preview": "python -m http.server 4173 --directory out",
    "sync:pyodide": "node scripts/sync-pyodide.mjs",
    "typecheck": "tsc --noEmit",
    "content": "python scripts/import_guide.py ../python-quick-guide.html"
  },
  "dependencies": {
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-serif-sc": "^5.3.1",
    "@uiw/react-codemirror": "4.25.12",
    "next": "16.4.6",
    "pyodide": "0.28.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  }
}
